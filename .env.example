DATABASE_URL="postgresql://petshop:petshop@localhost:5432/petshop?schema=public"
# Segredo para assinar a sessão (mín. 32 caracteres). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais"
# Provedor de notas fiscais. "simulated" gera notas de TESTE, sem validade fiscal (veja docs/FISCAL.md).
FISCAL_PROVIDER="simulated"
