generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATTENDANT
  GROOMER
  VET
}

// Cada pet shop é um Tenant. Toda tabela de negócio carrega tenantId.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         Role     @default(ATTENDANT)
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}
