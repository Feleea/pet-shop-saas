generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATTENDANT
  GROOMER
  VET
}

// Situação do acesso do usuário. INACTIVE e VACATION bloqueiam login e sessões já abertas.
// VACATION guarda a data prevista de retorno (vacationReturnsAt) para a futura reativação automática.
enum UserStatus {
  ACTIVE
  INACTIVE
  VACATION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum Species {
  DOG
  CAT
  BIRD
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

// Cada pet shop é um Tenant. Toda tabela de negócio carrega tenantId.
model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  users     User[]
  customers Customer[]
  services  Service[]
  invites   Invite[]
  products  Product[]
  sales     Sale[]
  // contador da numeração das vendas (1, 2, 3...) por pet shop; incrementado dentro da transação da venda
  saleSeq   Int        @default(0)
  returnSeq Int        @default(0)

  // Dados da empresa (comprovante e nota fiscal). Tudo opcional até a pessoa preencher em Configurações.
  legalName             String?
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             TaxRegime?
  addressLine           String?
  city                  String?
  state                 String?
  zipCode               String?
  phone                 String?
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         Role     @default(ATTENDANT)
  createdAt    DateTime @default(now())

  status            UserStatus @default(ACTIVE)
  vacationReturnsAt DateTime?
  statusChangedAt   DateTime   @default(now())
  appointments      Appointment[] @relation("AppointmentProfessional")
  salesCreated      Sale[]        @relation("SaleCreatedBy")
  movementsCreated  StockMovement[] @relation("MovementCreatedBy")
  returnsCreated    SaleReturn[]    @relation("ReturnCreatedBy")
  fiscalCreated     FiscalDocument[] @relation("FiscalCreatedBy")

  // permite a chave estrangeira composta de Appointment (profissional + tenant)
  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  // apoia a futura rotina que reativa quem está de férias (status = VACATION e vacationReturnsAt <= agora)
  @@index([status, vacationReturnsAt])
}

// Tutor / cliente do pet shop
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
  appointments Appointment[]
  sales     Sale[]

  // permite a chave estrangeira composta de Pet (id + tenantId)
  @@unique([id, tenantId])
  @@index([tenantId, name])
}

model Pet {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  // FK composta: o banco GARANTE que o pet pertence ao mesmo tenant do cliente.
  customer   Customer  @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  name       String
  species    Species
  breed      String?
  size       PetSize?
  birthDate  DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  appointments Appointment[]

  @@index([tenantId])
  @@index([customerId])
  // permite a chave estrangeira composta de Appointment (pet + cliente)
  @@unique([id, customerId])
}

// Catálogo de serviços do pet shop (banho, tosa, consulta...).
// Serviços são DESATIVADOS, não excluídos: a agenda (próxima etapa) vai referenciá-los.
model Service {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointments    Appointment[]
  saleItems       SaleItem[]
  // Fiscal (NFS-e): item da LC 116 (ex.: 05.08) e alíquota do ISS em centésimos de ponto percentual (500 = 5,00%)
  serviceCode     String?
  issRateBp       Int?

  @@unique([tenantId, name])
  // permite a chave estrangeira composta da futura tabela de agendamentos
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

// Convite para um novo usuário entrar num pet shop. Guardamos só o HASH do token:
// o link completo é exibido uma única vez, para quem convidou.
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, email])
}

// Agendamento. As chaves estrangeiras COMPOSTAS fazem o próprio banco garantir que cliente, pet, serviço
// e profissional pertencem ao mesmo pet shop (e que o pet é do cliente). Nome, duração e preço do serviço
// são copiados (snapshot): mudar o catálogo depois não altera agendamentos já feitos.
// Conflitos de horário são checados na criação/reagendamento, dentro de uma transação com trava (advisory lock).
model Appointment {
  id             String @id @default(cuid())
  tenantId       String
  customerId     String
  petId          String
  serviceId      String
  professionalId String

  customer     Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  pet          Pet      @relation(fields: [petId, customerId], references: [id, customerId], onDelete: Restrict)
  service      Service  @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  professional User     @relation("AppointmentProfessional", fields: [professionalId, tenantId], references: [id, tenantId], onDelete: Restrict)

  startsAt        DateTime
  endsAt          DateTime
  serviceName     String
  durationMinutes Int
  priceCents      Int
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  saleItems       SaleItem[]

  // permite a chave estrangeira composta de SaleItem (atendimento + tenant)
  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@index([petId, startsAt])
}

enum MovementType {
  INITIAL
  IN
  SALE
  RETURN
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum SaleItemKind {
  PRODUCT
  SERVICE
  APPOINTMENT
}

// Produto à venda. stockQuantity é o saldo atual e só muda junto com um StockMovement, na mesma transação.
// Produtos são DESATIVADOS, não excluídos: vendas e movimentações guardam o histórico.
model Product {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  priceCents    Int
  stockQuantity Int      @default(0)
  minStock      Int      @default(0)
  active        Boolean  @default(true)
  // Fiscal (NFC-e)
  ncm           String?
  cfop          String?
  csosn         String?
  unit          String   @default("UN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements StockMovement[]
  saleItems SaleItem[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

// Livro-razão do estoque: toda alteração de saldo deixa um registro (quem, quando, quanto, por quê).
model StockMovement {
  id          String       @id @default(cuid())
  tenantId    String
  productId   String
  product     Product      @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  type        MovementType
  // com sinal: positivo entra, negativo sai
  quantity    Int
  note        String?
  saleId      String?
  sale        Sale?        @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdById String
  createdBy   User         @relation("MovementCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([tenantId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  number        Int
  status        SaleStatus    @default(COMPLETED)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paymentMethod PaymentMethod
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  notes         String?
  createdById   String
  createdBy     User          @relation("SaleCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  canceledAt    DateTime?
  canceledById  String?
  cancelReason  String?
  // troca: parte do valor coberta pelo crédito de uma devolução (o resto é pago na forma de pagamento da venda)
  creditAppliedCents Int     @default(0)
  // devoluções: valor das mercadorias devolvidas (com o desconto rateado) e dinheiro já devolvido
  returnedValueCents Int     @default(0)
  refundedCents      Int     @default(0)
  exchangeOfReturnId String?

  items     SaleItem[]
  movements StockMovement[]
  returns   SaleReturn[]
  fiscalDocuments FiscalDocument[]

  @@unique([tenantId, number])
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

// Item de venda: produto OU atendimento concluído. Descrição e preço são copiados (snapshot).
model SaleItem {
  id              String       @id @default(cuid())
  tenantId        String
  saleId          String
  sale            Sale         @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  position        Int
  kind            SaleItemKind
  serviceId       String?
  service         Service?     @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  productId       String?
  product         Product?     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  description     String
  unitPriceCents  Int
  quantity        Int
  totalCents      Int
  // quanto já foi devolvido deste item (devolução parcial)
  returnedQuantity Int         @default(0)
  returnItems     SaleReturnItem[]

  // permite a chave estrangeira composta de SaleReturnItem
  @@unique([id, tenantId])
  @@index([saleId])
  @@index([productId])
  @@index([appointmentId])
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum FiscalKind {
  NFCE
  NFSE
}

enum FiscalStatus {
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELED
}

// SIMULATED = provedor de teste: o documento NÃO tem validade fiscal.
enum FiscalEnvironment {
  SIMULATED
  HOMOLOGATION
  PRODUCTION
}

// Devolução (parcial ou total) de itens de uma venda concluída. Pode vir junto com uma troca:
// nesse caso exchangeSaleId aponta para a nova venda e appliedCents é o crédito usado nela.
model SaleReturn {
  id             String         @id @default(cuid())
  tenantId       String
  number         Int
  saleId         String
  sale           Sale           @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reason         String
  // valor das mercadorias devolvidas (com o desconto da venda rateado)
  valueCents     Int
  appliedCents   Int            @default(0)
  refundCents    Int
  refundMethod   PaymentMethod?
  restocked      Boolean
  exchangeSaleId String?
  createdById    String
  createdBy      User           @relation("ReturnCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  items          SaleReturnItem[]

  @@unique([tenantId, number])
  @@unique([id, tenantId])
  @@index([saleId])
  @@index([tenantId, createdAt])
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  tenantId   String
  returnId   String
  saleReturn SaleReturn @relation(fields: [returnId, tenantId], references: [id, tenantId], onDelete: Restrict)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  quantity   Int
  valueCents Int
  restocked  Boolean

  @@index([returnId])
  @@index([saleItemId])
}

// Nota fiscal de uma venda: NFC-e para os produtos e NFS-e para os serviços (documentos separados).
// "request" guarda o que foi enviado ao provedor. Com o provedor SIMULADO não há validade fiscal.
model FiscalDocument {
  id              String            @id @default(cuid())
  tenantId        String
  saleId          String
  sale            Sale              @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  kind            FiscalKind
  status          FiscalStatus
  environment     FiscalEnvironment
  number          Int?
  series          Int?
  accessKey       String?
  protocol        String?
  providerRef     String?
  totalCents      Int
  rejectionReason String?
  request         Json
  issuedAt        DateTime?
  canceledAt      DateTime?
  cancelReason    String?
  createdById     String
  createdBy       User              @relation("FiscalCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@index([saleId])
  @@index([tenantId, kind, createdAt])
}
