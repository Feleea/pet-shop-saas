generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATTENDANT
  GROOMER
  VET
}

// Situação do acesso do usuário. INACTIVE e VACATION bloqueiam login e sessões já abertas.
// VACATION guarda a data prevista de retorno (vacationReturnsAt) para a futura reativação automática.
enum UserStatus {
  ACTIVE
  INACTIVE
  VACATION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum Species {
  DOG
  CAT
  BIRD
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

// Cada pet shop é um Tenant. Toda tabela de negócio carrega tenantId.
model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  users     User[]
  customers Customer[]
  services  Service[]
  invites   Invite[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         Role     @default(ATTENDANT)
  createdAt    DateTime @default(now())

  status            UserStatus @default(ACTIVE)
  vacationReturnsAt DateTime?
  statusChangedAt   DateTime   @default(now())
  appointments      Appointment[] @relation("AppointmentProfessional")

  // permite a chave estrangeira composta de Appointment (profissional + tenant)
  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  // apoia a futura rotina que reativa quem está de férias (status = VACATION e vacationReturnsAt <= agora)
  @@index([status, vacationReturnsAt])
}

// Tutor / cliente do pet shop
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
  appointments Appointment[]

  // permite a chave estrangeira composta de Pet (id + tenantId)
  @@unique([id, tenantId])
  @@index([tenantId, name])
}

model Pet {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  // FK composta: o banco GARANTE que o pet pertence ao mesmo tenant do cliente.
  customer   Customer  @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  name       String
  species    Species
  breed      String?
  size       PetSize?
  birthDate  DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  appointments Appointment[]

  @@index([tenantId])
  @@index([customerId])
  // permite a chave estrangeira composta de Appointment (pet + cliente)
  @@unique([id, customerId])
}

// Catálogo de serviços do pet shop (banho, tosa, consulta...).
// Serviços são DESATIVADOS, não excluídos: a agenda (próxima etapa) vai referenciá-los.
model Service {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointments    Appointment[]

  @@unique([tenantId, name])
  // permite a chave estrangeira composta da futura tabela de agendamentos
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

// Convite para um novo usuário entrar num pet shop. Guardamos só o HASH do token:
// o link completo é exibido uma única vez, para quem convidou.
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  email      String
  role       Role
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, email])
}

// Agendamento. As chaves estrangeiras COMPOSTAS fazem o próprio banco garantir que cliente, pet, serviço
// e profissional pertencem ao mesmo pet shop (e que o pet é do cliente). Nome, duração e preço do serviço
// são copiados (snapshot): mudar o catálogo depois não altera agendamentos já feitos.
// Conflitos de horário são checados na criação/reagendamento, dentro de uma transação com trava (advisory lock).
model Appointment {
  id             String @id @default(cuid())
  tenantId       String
  customerId     String
  petId          String
  serviceId      String
  professionalId String

  customer     Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  pet          Pet      @relation(fields: [petId, customerId], references: [id, customerId], onDelete: Restrict)
  service      Service  @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  professional User     @relation("AppointmentProfessional", fields: [professionalId, tenantId], references: [id, tenantId], onDelete: Restrict)

  startsAt        DateTime
  endsAt          DateTime
  serviceName     String
  durationMinutes Int
  priceCents      Int
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@index([petId, startsAt])
}
